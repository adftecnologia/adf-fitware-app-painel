# Variáveis de Ambiente para API Vercel

# Firebase Admin SDK - Necessário para API
FIREBASE_PROJECT_ID=project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@XXXXX.XXXX.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n YOUR PRIVATE KEY -----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://project-default-XXXX.firebaseio.com

# Ambiente de desenvolvimento
NODE_ENV=development

# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local na raiz do projeto
# 2. Substitua os valores pelos dados reais do seu projeto Firebase
# 3. Para obter as credenciais:
#    - Vá para Firebase Console > Configurações do projeto > Contas de serviço
#    - Clique em "Gerar nova chave privada"
#    - Baixe o arquivo JSON e extraia os valores
# 4. NUNCA commite o arquivo .env.local no Git

# CONFIGURAÇÃO NA VERCEL:
# No painel da Vercel, vá em Settings > Environment Variables e adicione:
# - FIREBASE_PROJECT_ID
# - FIREBASE_CLIENT_EMAIL  
# - FIREBASE_PRIVATE_KEY
# - FIREBASE_DATABASE_URL