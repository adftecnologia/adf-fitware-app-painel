# Variáveis de Ambiente para API Vercel

# Firebase Admin SDK - Necessário para API
FIREBASE_PROJECT_ID=project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@XXXXX.XXXX.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n YOUR PRIVATE KEY -----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://project-default-XXXX.firebaseio.com

# Ambiente de desenvolvimento
NODE_ENV=development

# Projeto de configuração (fitmanager-util) - gerencia tenants/environments de clientes
# Compartilhado com o app ponto-eletronico-biometrico (mesma centralização)
CONFIG_FIREBASE_PROJECT_ID=fitmanager-util
CONFIG_FIREBASE_CLIENT_EMAIL=firebase-adminsdk-XXXX@fitmanager-util.iam.gserviceaccount.com
CONFIG_FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n YOUR PRIVATE KEY -----END PRIVATE KEY-----\n"
CONFIG_FIREBASE_DATABASE_URL=https://fitmanager-util-default-rtdb.firebaseio.com

# Chave AES-256-GCM (32 bytes em base64) usada para cifrar as credenciais dos tenants
# Também cifra o refresh token do OAuth do Google (área "Criar Projeto")
TENANT_SA_ENC_KEY=BASE64_DE_32_BYTES_AQUI

# OAuth do Google - área "Criar Projeto" (criação automatizada de projetos Firebase)
# Crie um "OAuth Client ID" do tipo "Web application" no console do fitmanager-util.
# A tela de consentimento PRECISA estar publicada como "In production": em modo
# "Testing" o Google expira o refresh token a cada 7 dias.
# O redirect URI deve apontar para a rota de callback do painel.
GOOGLE_OAUTH_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-XXXXXXXXXXXXXXXX
# Produção: https://painel-fitware.adftecnologia.com.br/api/routes/google-oauth-callback
# Local:    http://localhost:3001/api/routes/google-oauth-callback
# Precisa bater EXATAMENTE com uma das URIs cadastradas no OAuth Client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/routes/google-oauth-callback

# Só em desenvolvimento: onde a INTERFACE do painel está, quando ela não fica
# na mesma origem das funções. Local o ng serve sobe em :4200 e o vercel dev em
# :3001, então sem isto o retorno do Google cairia na porta errada.
# Em produção, deixe em branco ou remova — app e funções dividem o domínio.
PAINEL_BASE_URL=http://localhost:4200

# Segredo do cron diário que mantém viva a conexão OAuth (string aleatória, 16+ chars).
# A Vercel envia este valor como "Authorization: Bearer <CRON_SECRET>" ao invocar o cron.
CRON_SECRET=STRING_ALEATORIA_AQUI

# INSTRUÇÕES:
# 1. Copie este arquivo para .env.local na raiz do projeto
# 2. Substitua os valores pelos dados reais do seu projeto Firebase
# 3. Para obter as credenciais:
#    - Vá para Firebase Console > Configurações do projeto > Contas de serviço
#    - Clique em "Gerar nova chave privada"
#    - Baixe o arquivo JSON e extraia os valores
# 4. NUNCA commite o arquivo .env.local no Git

# CONFIGURAÇÃO NA VERCEL:
# No painel da Vercel, vá em Settings > Environment Variables e adicione:
# - FIREBASE_PROJECT_ID
# - FIREBASE_CLIENT_EMAIL
# - FIREBASE_PRIVATE_KEY
# - FIREBASE_DATABASE_URL
# - CONFIG_FIREBASE_PROJECT_ID
# - CONFIG_FIREBASE_CLIENT_EMAIL
# - CONFIG_FIREBASE_PRIVATE_KEY
# - CONFIG_FIREBASE_DATABASE_URL
# - TENANT_SA_ENC_KEY
# - GOOGLE_OAUTH_CLIENT_ID
# - GOOGLE_OAUTH_CLIENT_SECRET
# - GOOGLE_OAUTH_REDIRECT_URI
# - CRON_SECRET