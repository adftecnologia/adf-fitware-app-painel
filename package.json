{
  "name": "painel-configuracao-fitware",
  "version": "1.8.3",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "start:dev": "concurrently \"npm run start -- --port 4200\" \"npm run api:dev\"",
    "start:dev:full": "concurrently \"npm run start -- --port 4200\" \"npm run build:api:watch\" \"npm run api:dev\"",
    "build:dev": "ng build --configuration development",
    "build:prod": "ng build --configuration production",
    "build:api": "tsc --project api/tsconfig.json",
    "build:api:watch": "tsc --project api/tsconfig.json --watch",
    "build:clean": "rimraf dist",
    "build": "node build-vercel.js",
    "api:dev": "vercel dev --listen 3001 --yes",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:api": "npm run build:api && echo 'API build successful - no test runner configured'",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\" \"api/**/*.ts\" \"lib/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\" \"api/**/*.ts\" \"lib/**/*.ts\"",
    "validar:config": "node scripts/validar-configuracao.js",
    "type-check": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project api/tsconfig.json",
    "lint:api": "tsc --noEmit --project api/tsconfig.json"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/fire": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@ng-select/ng-select": "^20.2.2",
    "bootstrap": "^5.3.8",
    "firebase": "^12.2.1",
    "firebase-admin": "^13.5.0",
    "ngx-mask": "^22.0.1",
    "ngx-pagination": "^6.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.17",
    "@angular/cli": "^19.2.17",
    "@angular/compiler-cli": "^19.2.0",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.9.1",
    "@vercel/node": "^5.4.1",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "~5.7.2",
    "vercel": "^48.4.1"
  }
}
